#!/bin/bash

set -o errexit
set -o nounset

delete_metrics() {
  [[ -z "${S3_ENDPOINT:-}" ]] && return
  local date sig
  date=$(date -R)
  sig=$(echo -en "DELETE\n\n\n${date}\n/${BUCKET_NAME}/${OBJECT_NAME}" \
    | openssl sha1 -hmac "${SECRET_KEY}" -binary | base64)
  curl --fail --max-time 30 -X DELETE \
    -H "Host: ${S3_ENDPOINT}" \
    -H "Date: ${date}" \
    -H "Authorization: AWS ${ACCESS_KEY}:${sig}" \
    "https://${S3_ENDPOINT}/${BUCKET_NAME}/${OBJECT_NAME}" || true
}

SUCCESS=false
trap '[[ "${SUCCESS}" == true ]] || delete_metrics' EXIT

# Set environment variables
if [ -e ipmi-power-exporter.conf ]; then
  . ipmi-power-exporter.conf
else
  . /etc/ipmi-power-exporter.conf
fi

# Generate metrics
FRUDATA="$(ipmitool fru print || :)"
MANUFACTURER="$(echo "${FRUDATA}" | sed -n 's/^ *Product Manufacturer *: *//p' | head -n1)"
PRODUCT="$(echo "${FRUDATA}" | sed -n 's/^ *Product Name *: *//p' | head -n1)"
HOST="$(cat /etc/hostname)"
DCMI="$(ipmitool dcmi power reading)"
POWER="$(echo "${DCMI}" | sed -n 's/^ *Instantaneous power reading: *\([0-9]*\) Watts$/\1/p')"
if [[ -z "${POWER}" ]]; then
  echo "ERROR: failed to read instantaneous power from ipmitool dcmi power reading" >&2
  exit 1
fi
POWER_MIN="$(echo "${DCMI}" | sed -n 's/^ *Minimum during sampling period: *\([0-9]*\) Watts$/\1/p')"
POWER_MAX="$(echo "${DCMI}" | sed -n 's/^ *Maximum during sampling period: *\([0-9]*\) Watts$/\1/p')"
POWER_AVG="$(echo "${DCMI}" | sed -n 's/^ *Average power reading over sample period: *\([0-9]*\) Watts$/\1/p')"
UPDATED="$(date +%s)"

LABELS="manufacturer=\"${MANUFACTURER}\", product=\"${PRODUCT}\", host=\"${HOST}\""
METRICS="# HELP power_watts Current power draw in watts
# TYPE power_watts gauge
power_watts{${LABELS}} ${POWER}"
[[ -n "${POWER_MIN}" ]] && METRICS+="
power_watts_min{${LABELS}} ${POWER_MIN}"
[[ -n "${POWER_MAX}" ]] && METRICS+="
power_watts_max{${LABELS}} ${POWER_MAX}"
[[ -n "${POWER_AVG}" ]] && METRICS+="
power_watts_avg{${LABELS}} ${POWER_AVG}"
METRICS+="
# HELP updated Unix timestamp of last metric update
# TYPE updated gauge
updated{host=\"${HOST}\"} ${UPDATED}"

# Calculate required values
CONTENT_TYPE="application/octet-stream"
DATE=$(date -R)
RESOURCE="/${BUCKET_NAME}/${OBJECT_NAME}"
SIGNATURE_STRING="PUT\n\n${CONTENT_TYPE}\n${DATE}\nx-amz-acl:public-read\n${RESOURCE}"
SIGNATURE=$(echo -en "${SIGNATURE_STRING}" | openssl sha1 -hmac "${SECRET_KEY}" -binary | base64)

# Upload file using curl
echo "${METRICS}" | curl --fail -X PUT --upload-file - \
  -H "Host: ${S3_ENDPOINT}" \
  -H "Date: ${DATE}" \
  -H "Content-Type: ${CONTENT_TYPE}" \
  -H "x-amz-acl: public-read" \
  -H "Authorization: AWS ${ACCESS_KEY}:${SIGNATURE}" \
  "https://${S3_ENDPOINT}/${BUCKET_NAME}/${OBJECT_NAME}"
SUCCESS=true
